// Prisma Schema: victoriapos

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// url và directUrl đã chuyển sang prisma.config.ts (Prisma 7 requirement)
datasource db {
  provider = "postgresql"
}

// Enums

enum UserRole {
  ADMIN
  STAFF
}

enum CustomerType {
  WALK_IN
  MEMBER
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DayType {
  WEEKDAY
  WEEKEND
}

enum PromotionDiscountType {
  FIXED_PER_HOUR
  PERCENT_PLAY_TIME
  FIXED_AMOUNT
  PERCENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  MEMBER
}

enum PaymentKind {
  OPERATIONAL
  MEMBERSHIP
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PAID
  CANCELLED
}

enum InvoiceItemType {
  PLAY_TIME
  MEMBERSHIP_FEE
  PRODUCT
  SERVICE
  DISCOUNT
  SURCHARGE
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  VOID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum ShiftParticipantRole {
  LEAD
  STAFF
}

enum CashflowType {
  INCOME
  EXPENSE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum LessonAttendance {
  SCHEDULED
  COMPLETED
  ABSENT
}

// Models

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  payments           Payment[]
  shifts             Shift[]
  shiftParticipants  ShiftParticipant[]
  invoices           Invoice[]
  stockMovements     StockMovement[]
  activityLogs       ActivityLog[]
  cashflowEntries    CashflowEntry[]

  @@map("users")
}

model Customer {
  id               String       @id @default(uuid())
  fullName         String       @map("full_name") @db.VarChar(100)
  phone            String?      @db.VarChar(20)
  type             CustomerType @default(WALK_IN)
  totalHoursPlayed Decimal      @default(0) @map("total_hours_played") @db.Decimal(10, 2)
  totalSpent       Decimal      @default(0) @map("total_spent") @db.Decimal(12, 0)
  notes            String?      @db.Text
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  sessions           Session[]
  memberships        Membership[]
  invoices           Invoice[]
  payments           Payment[]

  @@index([type])
  @@map("customers")
}

model Session {
  id                     String                 @id @default(uuid())
  customerId             String?                @map("customer_id")
  customer               Customer?              @relation(fields: [customerId], references: [id])
  /**
   * Tên khách vãng lai lưu ngay trên phiên (không tạo Customer) — hội viên lấy từ customer.fullName
   */
  customerName           String?                @map("customer_name") @db.VarChar(100)
  staffId                String                 @map("staff_id")
  staff                  User                   @relation(fields: [staffId], references: [id])
  shiftId                String?                @map("shift_id")
  shift                  Shift?                 @relation(fields: [shiftId], references: [id])
  membershipId           String?                @map("membership_id")
  membership             Membership?            @relation(fields: [membershipId], references: [id])
  startTime              DateTime               @map("start_time")
  endTime                DateTime?              @map("end_time")
  pausedAt               DateTime?              @map("paused_at")
  totalPausedSeconds     Int                    @default(0) @map("total_paused_seconds")
  status                 SessionStatus          @default(ACTIVE)
  totalHours             Decimal?               @map("total_hours") @db.Decimal(5, 2)
  hourlyRate             Decimal                @map("hourly_rate") @db.Decimal(10, 0)
  pricingRuleId          String?                @map("pricing_rule_id")
  pricingRuleSnapshot    Json?                  @map("pricing_rule_snapshot")
  promotionRuleId        String?                @map("promotion_rule_id")
  promotionName          String?                @map("promotion_name") @db.VarChar(100)
  promotionDiscountType  PromotionDiscountType? @map("promotion_discount_type")
  promotionDiscountValue Decimal?               @map("promotion_discount_value") @db.Decimal(12, 2)
  subtotal               Decimal?               @db.Decimal(12, 0)
  discountAmount         Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 0)
  totalAmount            Decimal?               @map("total_amount") @db.Decimal(12, 0)
  playerCount            Int                    @default(1) @map("player_count")
  notes                  String?                @db.Text
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  payments      Payment[]
  invoices      Invoice[]
  pricingGroups SessionPricingGroup[]
  players       SessionPlayer[]

  @@index([customerId, status])
  @@index([shiftId])
  @@index([membershipId])
  @@index([pricingRuleId])
  @@index([promotionRuleId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("sessions")
}

model SessionPricingGroup {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  label           String   @default("") @db.VarChar(50)
  playerCount     Int      @map("player_count")
  remainingCount  Int      @map("remaining_count")
  hourlyRate      Decimal  @map("hourly_rate") @db.Decimal(10, 0)
  pricingRuleId   String?  @map("pricing_rule_id")
  pricingSnapshot Json?    @map("pricing_snapshot")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  players SessionPlayer[]

  @@index([sessionId])
  @@map("session_pricing_groups")
}

model SessionPlayer {
  id                 String              @id @default(uuid())
  sessionId          String              @map("session_id")
  session            Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  groupId            String              @map("group_id")
  group              SessionPricingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name               String?             @db.VarChar(100)
  pausedAt           DateTime?           @map("paused_at")
  totalPausedSeconds Int                 @default(0) @map("total_paused_seconds")
  checkedOutAt       DateTime?           @map("checked_out_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([groupId])
  @@map("session_players")
}

model PricingRule {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(100)
  daysOfWeek    Int[]     @default([]) @map("days_of_week")
  hourFrom      Int       @map("hour_from")
  hourTo        Int?      @map("hour_to")
  ratePerHour   Decimal   @map("rate_per_hour") @db.Decimal(12, 2)
  dayType       DayType   @default(WEEKDAY) @map("day_type")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tiers PricingTier[]

  @@index([dayType, hourFrom, hourTo])
  @@map("pricing_rules")
}

model PricingTier {
  id          String      @id @default(uuid())
  ruleId      String      @map("rule_id")
  rule        PricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  minHours    Int         @map("min_hours")
  ratePerHour Decimal     @map("rate_per_hour") @db.Decimal(12, 2)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([ruleId, minHours])
  @@map("pricing_tiers")
}

model PromotionRule {
  id            String                @id @default(uuid())
  name          String                @db.VarChar(100)
  discountType  PromotionDiscountType @map("discount_type")
  discountValue Decimal               @map("discount_value") @db.Decimal(12, 2)
  daysOfWeek    Int[]                 @default([]) @map("days_of_week")
  hourFrom      Int                   @map("hour_from")
  hourTo        Int?                  @map("hour_to")
  dayType       DayType               @default(WEEKDAY) @map("day_type")
  effectiveFrom DateTime              @map("effective_from")
  effectiveTo   DateTime?             @map("effective_to")
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([isActive, dayType, hourFrom, hourTo])
  @@index([effectiveFrom, effectiveTo])
  @@map("promotion_rules")
}

model MembershipPlan {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  durationMonths Int      @default(1) @map("duration_months")
  price          Decimal  @db.Decimal(12, 0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberships        Membership[]
  payments           Payment[]

  @@map("membership_plans")
}

model Membership {
  id         String           @id @default(uuid())
  customerId String           @map("customer_id")
  customer   Customer         @relation(fields: [customerId], references: [id])
  planId     String           @map("plan_id")
  plan       MembershipPlan   @relation(fields: [planId], references: [id])
  startsAt   DateTime         @map("starts_at")
  expiresAt  DateTime         @map("expires_at")
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  sessions           Session[]
  payments           Payment[]

  @@index([customerId, startsAt, expiresAt])
  @@index([status])
  @@map("memberships")
}

model Shift {
  id             String      @id @default(uuid())
  staffId        String      @map("staff_id")
  staff          User        @relation(fields: [staffId], references: [id])
  openSlot       String?     @unique @map("open_slot") @db.VarChar(30)
  openedAt       DateTime    @default(now()) @map("opened_at")
  closedAt       DateTime?   @map("closed_at")
  openingCash    Decimal     @default(0) @map("opening_cash") @db.Decimal(12, 0)
  closingCash    Decimal?    @map("closing_cash") @db.Decimal(12, 0)
  expectedCash   Decimal?    @map("expected_cash") @db.Decimal(12, 0)
  cashDifference Decimal?    @map("cash_difference") @db.Decimal(12, 0)
  status         ShiftStatus @default(OPEN)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  sessions           Session[]
  participants       ShiftParticipant[]
  toolCounts         ShiftTool[]
  invoices           Invoice[]
  payments           Payment[]
  stockMovements     StockMovement[]

  @@index([staffId, status])
  @@index([openedAt])
  @@map("shifts")
}

model ShiftParticipant {
  id        String               @id @default(uuid())
  shiftId   String               @map("shift_id")
  shift     Shift                @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staffId   String               @map("staff_id")
  staff     User                 @relation(fields: [staffId], references: [id])
  role      ShiftParticipantRole @default(STAFF)
  joinedAt  DateTime             @default(now()) @map("joined_at")
  leftAt    DateTime?            @map("left_at")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([shiftId, staffId])
  @@index([staffId, leftAt])
  @@index([shiftId, leftAt])
  @@map("shift_participants")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNo     String        @unique @map("invoice_no") @db.VarChar(40)
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  sessionId     String?       @map("session_id")
  session       Session?      @relation(fields: [sessionId], references: [id])
  shiftId       String?       @map("shift_id")
  shift         Shift?        @relation(fields: [shiftId], references: [id])
  staffId       String        @map("staff_id")
  staff         User          @relation(fields: [staffId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(12, 0)
  discountTotal Decimal       @default(0) @map("discount_total") @db.Decimal(12, 0)
  grandTotal    Decimal       @default(0) @map("grand_total") @db.Decimal(12, 0)
  paidAt        DateTime?     @map("paid_at")
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items              InvoiceItem[]
  payments           Payment[]

  @@index([customerId])
  @@index([sessionId])
  @@index([sessionId, status])
  @@index([shiftId])
  @@index([paidAt])
  @@map("invoices")
}

model InvoiceItem {
  id             String          @id @default(uuid())
  invoiceId      String          @map("invoice_id")
  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  productId      String?         @map("product_id")
  product        Product?        @relation(fields: [productId], references: [id])
  type           InvoiceItemType
  description    String          @db.VarChar(200)
  quantity       Decimal         @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal         @default(0) @map("unit_price") @db.Decimal(12, 0)
  unitCost       Decimal?        @map("unit_cost") @db.Decimal(12, 0)
  subtotal       Decimal         @default(0) @db.Decimal(12, 0)
  discountAmount Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 0)
  total          Decimal         @default(0) @db.Decimal(12, 0)
  metadata       Json?           @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at")

  stockMovements StockMovement[]

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid())
  kind          PaymentKind   @default(OPERATIONAL)
  sessionId     String?       @map("session_id")
  session       Session?      @relation(fields: [sessionId], references: [id])
  invoiceId     String?       @map("invoice_id")
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  shiftId       String?       @map("shift_id")
  shift         Shift?        @relation(fields: [shiftId], references: [id])
  staffId       String        @map("staff_id")
  staff         User          @relation(fields: [staffId], references: [id])
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  membershipId  String?       @map("membership_id")
  membership    Membership?   @relation(fields: [membershipId], references: [id])
  planId        String?       @map("plan_id")
  plan          MembershipPlan? @relation(fields: [planId], references: [id])
  totalHours    Decimal       @map("total_hours") @db.Decimal(5, 2)
  subtotal      Decimal       @db.Decimal(12, 0)
  discountTotal Decimal       @default(0) @map("discount_total") @db.Decimal(12, 0)
  grandTotal    Decimal       @map("grand_total") @db.Decimal(12, 0)
  paymentMethod PaymentMethod @map("payment_method")
  paidAt        DateTime      @default(now()) @map("paid_at")
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([shiftId])
  @@index([paidAt])
  @@index([kind])
  @@index([customerId, paidAt])
  @@map("payments")
}

model Product {
  id            String      @id @default(uuid())
  name          String      @db.VarChar(120)
  sku           String?     @unique @db.VarChar(50)
  type          ProductType @default(PRODUCT)
  price         Decimal     @db.Decimal(12, 0)
  costPrice     Decimal?    @map("cost_price") @db.Decimal(12, 0)
  stockQuantity Int         @default(0) @map("stock_quantity")
  minStockLevel Int         @default(0) @map("min_stock_level")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@index([isActive])
  @@map("products")
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     String            @map("product_id")
  product       Product           @relation(fields: [productId], references: [id])
  invoiceItemId String?           @map("invoice_item_id")
  invoiceItem   InvoiceItem?      @relation(fields: [invoiceItemId], references: [id])
  shiftId       String?           @map("shift_id")
  shift         Shift?            @relation(fields: [shiftId], references: [id])
  staffId       String?           @map("staff_id")
  staff         User?             @relation(fields: [staffId], references: [id])
  type          StockMovementType
  quantity      Int
  unitCost      Decimal?          @map("unit_cost") @db.Decimal(12, 0)
  reason        String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([shiftId])
  @@map("stock_movements")
}

model Tool {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(120)
  description String?  @db.Text
  quantity    Int      @default(0)
  isRequired  Boolean  @default(false) @map("is_required")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shiftTools ShiftTool[]

  @@map("tools")
}

model ShiftTool {
  id         String   @id @default(uuid())
  shiftId    String   @map("shift_id")
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  toolId     String   @map("tool_id")
  tool       Tool     @relation(fields: [toolId], references: [id])
  openCount  Int      @default(0) @map("open_count")
  closeCount Int?     @map("close_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([shiftId, toolId])
  @@map("shift_tools")
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(100)
  value     String   @db.VarChar(255)
  label     String?  @db.VarChar(200)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("app_settings")
}

model CashflowEntry {
  id         String       @id @default(uuid())
  type       CashflowType
  personName String       @map("person_name") @db.VarChar(100)
  amount     Decimal      @db.Decimal(12, 0)
  reason     String       @db.Text
  staffId    String       @map("staff_id")
  staff      User         @relation(fields: [staffId], references: [id])
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([type, createdAt])
  @@map("cashflow_entries")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  details    Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("activity_logs")
}

// ── Domain Học viên (tách biệt khỏi POS/Customer) ─────

model Student {
  id        String        @id @default(uuid())
  fullName  String        @map("full_name") @db.VarChar(100)
  phone     String?       @db.VarChar(20)
  birthYear Int?          @map("birth_year")
  notes     String?       @db.Text
  status    StudentStatus @default(ACTIVE)
  deletedAt DateTime?     @map("deleted_at") // soft delete — giữ lịch sử
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  packages LessonPackage[]
  lessons  LessonStudent[]

  @@index([status])
  @@map("students")
}

model LessonPackage {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(100)
  total     Int      @default(1) // số buổi đã mua
  used      Int      @default(0) // số buổi đã dùng
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lessonStudents LessonStudent[]

  @@index([studentId, isActive])
  @@map("lesson_packages")
}

model LessonSeries {
  id            String    @id @default(uuid())
  title         String    @db.VarChar(150)
  coachName     String?   @map("coach_name") @db.VarChar(100)
  daysOfWeek    Int[]     @map("days_of_week") // [1,4] = T2, T5 (0=CN)
  startTime     String    @map("start_time") @db.VarChar(5) // "18:00"
  durationMin   Int       @default(60) @map("duration_min")
  rrule         String    @db.VarChar(200) // FREQ=WEEKLY;BYDAY=MO,TH
  startsOn      DateTime  @map("starts_on")
  endsOn        DateTime? @map("ends_on")
  isActive      Boolean   @default(true) @map("is_active")
  googleEventId String?   @map("google_event_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lessons Lesson[]

  @@index([startsOn])
  @@map("lesson_series")
}

model Lesson {
  id            String         @id @default(uuid())
  seriesId      String?        @map("series_id")
  series        LessonSeries?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  title         String         @db.VarChar(150)
  coachName     String?        @map("coach_name") @db.VarChar(100)
  startsAt      DateTime       @map("starts_at")
  durationMin   Int            @default(60) @map("duration_min")
  status        LessonStatus   @default(SCHEDULED)
  note          String?        @db.Text // note cấp buổi
  googleEventId String?        @map("google_event_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  students LessonStudent[]

  @@index([startsAt])
  @@index([seriesId])
  @@map("lessons")
}

model LessonStudent {
  id        String           @id @default(uuid())
  lessonId  String           @map("lesson_id")
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String           @map("student_id")
  student   Student          @relation(fields: [studentId], references: [id])
  status    LessonAttendance @default(SCHEDULED)
  note      String?          @db.Text // note riêng từng HV
  packageId String?          @map("package_id") // gói bị trừ khi hoàn thành buổi này
  package   LessonPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("lesson_students")
}

model CalendarConnection {
  id             String   @id @default(uuid())
  email          String   @db.VarChar(200)
  accessToken    String   @map("access_token") @db.Text
  refreshToken   String   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime @map("token_expires_at")
  calendarId     String?  @map("calendar_id") @db.VarChar(200) // null = calendar "primary"
  connectedAt    DateTime @default(now()) @map("connected_at")

  @@map("calendar_connections")
